# Скопируйте этот файл в .env и заполните значения. Файл .env в git не попадает.

# Обязательно: любая длинная случайная строка (подпись сессий, ключ шифрования токена Moodle).
SECRET_KEY=замените-на-длинную-случайную-строку

# База данных. Если ничего не задано — используется SQLite в instance/pr3.db.
# DATABASE_URL=sqlite:///instance/pr3.db
# Для MySQL вместо DATABASE_URL:
# DB_USER=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=

# Почта для кодов подтверждения. Если SMTP_HOST не задан и FLASK_ENV не production,
# код подтверждения печатается в консоль сервера (удобно для разработки).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=1

# Боевой режим: включает Secure-cookie и требует настроенную почту.
# FLASK_ENV=production
# COOKIE_SECURE=1

# Если приложение стоит за прокси (nginx и т. п.) — иначе лимиты считаются по IP прокси.
# TRUST_PROXY=1

# Часовой пояс для «сегодня» и времени на страницах (по умолчанию Europe/Moscow).
# APP_TIMEZONE=Europe/Moscow

# Дата начала семестра (ГГГГ-ММ-ДД): от неё считается чётность недель.
# SEMESTER_START=2026-09-01

# Отдельный ключ шифрования токена Moodle (по умолчанию выводится из SECRET_KEY).
# MOODLE_TOKEN_KEY=

# Общие лимиты запросов на IP (через «;»). Вход и регистрация ограничены строже.
# RATELIMIT_DEFAULT=1000 per day;300 per hour
# Для нескольких процессов укажите Redis:
# RATELIMIT_STORAGE_URI=redis://localhost:6379
